@startuml
left to right direction
skinparam actorStyle awesome

title Diagramme de cas d'utilisation général

actor "Gestionnaire" as G
actor "Administrateur" as A

rectangle "Système de dématérialisation\nde la gestion des candidatures" {

  usecase "S'authentifier" as UC_Auth

  usecase "Consulter le tableau de bord" as UC_Dashboard

  usecase "Consulter la liste\ndes candidats" as UC_Candidats_List
  usecase "Consulter la liste\ndes concours" as UC_Concours_List
  usecase "Consulter la liste des centres,\nétablissements et salles" as UC_Lieux_List
  usecase "Consulter la répartition" as UC_Repartition_Consult
  usecase "Consulter la liste\ndes convocations" as UC_Convocations_List

  usecase "Gérer les candidats" as UC_Candidats_Gest
  usecase "Gérer les concours" as UC_Concours_Gest
  usecase "Gérer centres, établissements\net lieux" as UC_Lieux_Gest
  usecase "Lancer la répartition" as UC_Repartition_Launch
  usecase "Gérer les convocations" as UC_Convocations_Gest
  usecase "Gérer les comptes" as UC_Comptes_Gest
}

' --- Administrateur ---
A --> UC_Dashboard
A --> UC_Candidats_List
A --> UC_Concours_List
A --> UC_Lieux_List
A --> UC_Repartition_Consult
A --> UC_Convocations_List
A --> UC_Comptes_Gest

' --- Gestionnaire ---
G --> UC_Dashboard
G --> UC_Candidats_List
G --> UC_Concours_List
G --> UC_Lieux_List
G --> UC_Convocations_List
G --> UC_Candidats_Gest
G --> UC_Concours_Gest
G --> UC_Lieux_Gest
G --> UC_Repartition_Launch
G --> UC_Repartition_Consult
G --> UC_Convocations_Gest

' --- Authentification requise pour toutes les actions ---
UC_Dashboard ..> UC_Auth : <<include>>
UC_Candidats_List ..> UC_Auth : <<include>>
UC_Concours_List ..> UC_Auth : <<include>>
UC_Lieux_List ..> UC_Auth : <<include>>
UC_Repartition_Consult ..> UC_Auth : <<include>>
UC_Convocations_List ..> UC_Auth : <<include>>
UC_Candidats_Gest ..> UC_Auth : <<include>>
UC_Concours_Gest ..> UC_Auth : <<include>>
UC_Lieux_Gest ..> UC_Auth : <<include>>
UC_Repartition_Launch ..> UC_Auth : <<include>>
UC_Convocations_Gest ..> UC_Auth : <<include>>
UC_Comptes_Gest ..> UC_Auth : <<include>>

@enduml
