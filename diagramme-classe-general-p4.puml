@startuml diagramme-classe-general-4
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40
skinparam dpi 150
hide empty methods
hide circle

<style>
title {
  FontSize 22
  FontStyle bold
}
legend {
  FontSize 15
}
package {
  FontSize 16
  FontStyle bold
}
class {
  FontSize 16
  Header {
    FontSize 17
    FontStyle bold
  }
}
enum {
  FontSize 15
}
note {
  FontSize 14
}
arrow {
  FontSize 14
  LineThickness 1.2
}
</style>

title Dématérialisation des candidatures — Classes (4/4)\nConvocations

legend bottom
  Flèche pointillée = référence par identifiant
  <<assemblé>> = calculé à la lecture, non persisté
endlegend

package "Convocations" #FFF4F4 {
  class Convocation <<assemblé>> {
    + numeroInscription : String
    + nomCentre : String
    + nomSalle : String
    + dateHeureExamen : Instant
    + numeroPlace : Integer
    --
    + consulter()
    + telechargerPdf()
    + envoyerToutes()
  }
  class ConvocationEnvoi {
    - id : Long <<PK>>
    + numeroInscription : String
    + statut : EnvoiStatut
    + envoyeLe : Instant
    --
    + consulter()
    + reinitialiser()
  }
  enum EnvoiStatut <<enumeration>> {
    ENVOYE
    ECHEC
  }
  ConvocationEnvoi --> EnvoiStatut
  Convocation -[hidden]down- ConvocationEnvoi
}

package "Candidats" #F6FFF4 {
  class Candidat {
    - numeroInscription : String <<PK>>
  }
}

Candidat "1" ..> "0..1" Convocation
ConvocationEnvoi "0..*" ..> "1" Candidat
ConvocationEnvoi -[hidden]down- Candidat

note bottom of Convocation
  Assemblée seulement si le candidat
  a un siège complet (centre, établissement,
  salle et numéro de place). Le PDF n'est
  pas stocké ; seul l'envoi est historisé.
end note

@enduml
