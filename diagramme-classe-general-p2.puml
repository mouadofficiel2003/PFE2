@startuml diagramme-classe-general-2
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 50
skinparam dpi 150
hide empty methods
hide circle

<style>
title {
  FontSize 22
  FontStyle bold
}
legend {
  FontSize 15
}
package {
  FontSize 16
  FontStyle bold
}
class {
  FontSize 16
  Header {
    FontSize 17
    FontStyle bold
  }
}
enum {
  FontSize 15
}
note {
  FontSize 14
}
arrow {
  FontSize 14
  LineThickness 1.2
}
</style>

title Dématérialisation des candidatures — Classes (2/4)\nCandidats

legend bottom
  Flèche pointillée = référence par identifiant (voir figures 1, 3 et 4)
endlegend

package "Candidats" #F6FFF4 {
  class Candidat {
    - numeroInscription : String <<PK>>
    + nom : String
    + prenom : String
    + cin : String {unique}
    + ville : String
    + email : String
    + numeroConcours : String
    + idCentre : Long
    + idEtablissement : Long
    + idSalle : Long
    + numeroPlace : Integer
    --
    + importer()
    + consulter()
    + modifier()
    + supprimer()
    + reinitialiserListe()
    + affecterManuellement()
  }
}

note right of Candidat
  **Création :** uniquement par import Excel
  (pas de création unitaire).
  **Références (figure 1) :**
  numeroConcours → Concours
  idCentre → Centre
  idEtablissement → Établissement
  idSalle → Salle
  **Après répartition :**
  siège = centre + établissement
  + salle + numéro de place.
end note

@enduml
