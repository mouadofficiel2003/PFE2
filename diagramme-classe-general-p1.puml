@startuml diagramme-classe-general-1
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 50
skinparam dpi 150
hide empty methods
hide circle

<style>
title {
  FontSize 22
  FontStyle bold
}
legend {
  FontSize 15
}
package {
  FontSize 16
  FontStyle bold
}
class {
  FontSize 16
  Header {
    FontSize 17
    FontStyle bold
  }
}
enum {
  FontSize 15
}
note {
  FontSize 14
}
arrow {
  FontSize 14
  LineThickness 1.2
}
</style>

title Dématérialisation des candidatures — Classes (1/4)\nAuthentification, concours et lieux d'examen

legend bottom
  Losange plein = composition  ·  Flèche pointillée = référence par identifiant
  Noms uniques : centre (global) ; établissement **dans** le centre ; salle **dans** l'établissement
endlegend

package "Authentification" #F8F8F8 {
  enum RoleUtilisateur <<enumeration>> {
    ADMINISTRATEUR
    GESTIONNAIRE
  }
  class Utilisateur {
    - id : Long <<PK>>
    + nomUtilisateur : String {unique}
    + role : RoleUtilisateur
    + actif : boolean
    --
    + sAuthentifier()
    + creer()
    + modifier()
    + supprimer()
    + consulter()
  }
  Utilisateur --> RoleUtilisateur
}

package "Concours" #F4FAFF {
  class Concours {
    - numeroConcours : String <<PK>>
    + nomConcours : String
    + dateHeureExamen : Instant
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class ConcoursAffectationCentre {
    + idCentre : Long
    + nomCentre : String
  }
  Concours "1" *-- "1..*" ConcoursAffectationCentre
}

package "Lieux d'examen" #FFF8F0 {
  class Centre {
    - idCentre : Long <<PK>>
    + nomCentre : String {unique}
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Etablissement {
    - idEtablissement : Long <<PK>>
    + nomEtablissement : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Salle {
    - idSalle : Long <<PK>>
    + nomSalle : String
    + nombrePlaces : int
    + numeroConcours : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  Centre "1" *-- "0..*" Etablissement
  Etablissement "1" *-- "0..*" Salle
}

ConcoursAffectationCentre "0..*" ..> "1" Centre
Salle "0..*" ..> "0..1" Concours

@enduml
