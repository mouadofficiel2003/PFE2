@startuml diagramme-classe-general
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 45
skinparam dpi 96
hide empty methods
hide circle

<style>
title {
  FontSize 22
  FontStyle bold
}
legend {
  FontSize 15
}
package {
  FontSize 16
  FontStyle bold
}
class {
  FontSize 16
  Header {
    FontSize 17
    FontStyle bold
  }
}
entity {
  FontSize 16
}
enum {
  FontSize 15
}
note {
  FontSize 14
}
arrow {
  FontSize 14
  LineThickness 1.2
}
</style>

title Dématérialisation des candidatures — Diagramme de classes général

legend bottom
  Losange plein = composition  ·  Flèche pointillée = référence par identifiant
  <<assemblé>> = calculé à la lecture, non persisté
  Noms uniques : centre (global) ; établissement **dans** le centre ; salle **dans** l'établissement
endlegend

package "Authentification" #F8F8F8 {
  enum RoleUtilisateur <<enumeration>> {
    ADMINISTRATEUR
    GESTIONNAIRE
  }
  class Utilisateur {
    - id : Long <<PK>>
    + nomUtilisateur : String {unique}
    + role : RoleUtilisateur
    + actif : boolean
    --
    + sAuthentifier()
    + creer()
    + modifier()
    + supprimer()
    + consulter()
  }
  Utilisateur --> RoleUtilisateur
}

package "Concours" #F4FAFF {
  class Concours {
    - numeroConcours : String <<PK>>
    + nomConcours : String
    + dateHeureExamen : Instant
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class ConcoursAffectationCentre {
    + idCentre : Long
    + nomCentre : String
  }
  Concours "1" *-- "1..*" ConcoursAffectationCentre
}

package "Lieux d'examen" #FFF8F0 {
  class Centre {
    - idCentre : Long <<PK>>
    + nomCentre : String {unique}
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Etablissement {
    - idEtablissement : Long <<PK>>
    + nomEtablissement : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Salle {
    - idSalle : Long <<PK>>
    + nomSalle : String
    + nombrePlaces : int
    + numeroConcours : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  Centre "1" *-- "0..*" Etablissement
  Etablissement "1" *-- "0..*" Salle
}

package "Candidats" #F6FFF4 {
  class Candidat {
    - numeroInscription : String <<PK>>
    + nom : String
    + prenom : String
    + cin : String {unique}
    + ville : String
    + email : String
    + numeroConcours : String
    + idCentre : Long
    + idEtablissement : Long
    + idSalle : Long
    + numeroPlace : Integer
    --
    + importer()
    + consulter()
    + modifier()
    + supprimer()
    + reinitialiserListe()
    + affecterManuellement()
  }
}

package "Répartition" #FAF4FF {
  enum RepartitionStatut <<enumeration>> {
    TERMINEE
    TERMINEE_AVEC_ALERTES
    ECHEC
  }
  enum AlerteType <<enumeration>> {
    CAPACITE_DEPASSEE
    AUCUN_CENTRE_DISPONIBLE
    CONCOURS_INCONNU
    VILLE_NON_GEOLOCALISEE
  }
  class RepartitionRun {
    - id : Long <<PK>>
    + statut : RepartitionStatut
    + totalCandidats : int
    + totalAffectes : int
    + totalAlertes : int
    --
    + lancer()
    + consulter()
    + reinitialiserAffectations()
    + supprimer()
  }
  class RepartitionAffectation {
    + numeroInscription : String
    + numeroPlace : Integer
  }
  class RepartitionAlerte {
    + type : AlerteType
    + numeroInscription : String
  }
  RepartitionRun --> RepartitionStatut
  RepartitionRun "1" *-- "0..*" RepartitionAffectation
  RepartitionRun "1" *-- "0..*" RepartitionAlerte
  RepartitionAlerte --> AlerteType
}

package "Convocations" #FFF4F4 {
  class Convocation <<assemblé>> {
    + numeroInscription : String
    + nomCentre : String
    + nomSalle : String
    + dateHeureExamen : Instant
    + numeroPlace : Integer
    --
    + consulter()
    + telechargerPdf()
    + envoyerToutes()
  }
  class ConvocationEnvoi {
    - id : Long <<PK>>
    + numeroInscription : String
    + statut : EnvoiStatut
    + envoyeLe : Instant
    --
    + consulter()
    + reinitialiser()
  }
  enum EnvoiStatut <<enumeration>> {
    ENVOYE
    ECHEC
  }
  ConvocationEnvoi --> EnvoiStatut
}

ConcoursAffectationCentre "0..*" ..> "1" Centre
Salle "0..*" ..> "0..1" Concours
Candidat "0..*" ..> "0..1" Concours
Candidat "0..*" ..> "0..1" Salle
RepartitionAffectation "0..*" ..> "1" Candidat
RepartitionAlerte "0..*" ..> "0..1" Candidat
Candidat "1" ..> "0..1" Convocation
ConvocationEnvoi "0..*" ..> "1" Candidat

@enduml
