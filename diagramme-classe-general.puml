@startuml diagramme-classe-general
!theme plain
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 8
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 45
skinparam dpi 140
skinparam defaultFontName Arial
hide empty methods
hide circle

<style>
title {
  FontSize 22
  FontStyle bold
  Margin 4
}
package {
  FontSize 16
  FontStyle bold
  Margin 4
  Padding 8
}
class {
  FontSize 13
  Padding 5
  Header {
    FontSize 15
    FontStyle bold
  }
}
enum {
  FontSize 13
  Padding 4
  Header {
    FontSize 14
    FontStyle bold
  }
}
legend {
  FontSize 13
}
arrow {
  FontSize 12
  LineThickness 1.4
}
</style>

title Dématérialisation des candidatures — Diagramme de classes général

legend left
  **Légende**
  Losange plein = composition (même agrégat / même base)
  Flèche pointillée = référence par identifiant (service distinct)
  <<assemblé>> = calculé à la lecture, **non persisté**
  **{copie}** = libellé dénormalisé, recopié à l'écriture
  (l'historique reste lisible si la source est renommée)
  Unicité des noms : centre **global** ;
  établissement **dans** le centre ;
  salle **dans** l'établissement
endlegend

package "Authentification" as pkgAuth #F8F8F8 {
  class Utilisateur {
    - id : Long <<PK>>
    + nomUtilisateur : String {unique}
    + role : RoleUtilisateur
    + actif : boolean
    --
    + sAuthentifier()
    + creer()
    + modifier()
    + supprimer()
    + consulter()
  }
  enum RoleUtilisateur <<enumeration>> {
    ADMINISTRATEUR
    GESTIONNAIRE
  }
  Utilisateur --> RoleUtilisateur
}

package "Lieux d'examen" as pkgLieux #FFF8F0 {
  class Centre {
    - idCentre : Long <<PK>>
    + nomCentre : String {unique}
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Etablissement {
    - idEtablissement : Long <<PK>>
    + nomEtablissement : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class Salle {
    - idSalle : Long <<PK>>
    + nomSalle : String
    + nombrePlaces : int
    + numeroConcours : String
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  Centre "1" *-- "0..*" Etablissement
  Etablissement "1" *-- "0..*" Salle
}

package "Concours" as pkgConcours #F4FAFF {
  class Concours {
    - numeroConcours : String <<PK>>
    + nomConcours : String
    + dateHeureExamen : Instant
    --
    + consulter()
    + creer()
    + modifier()
    + supprimer()
  }
  class ConcoursAffectationCentre {
    - id : Long <<PK>>
    + idCentre : Long
    + nomCentre : String {copie}
  }
  Concours "1" *-- "1..*" ConcoursAffectationCentre
}

package "Candidats" as pkgCandidats #F6FFF4 {
  class Candidat {
    - numeroInscription : String <<PK>>
    .. identité ..
    + nom : String
    + prenom : String
    + cin : String {unique}
    + numeroTelephone : String
    + ville : String
    + age : short
    + email : String
    + specialite : String
    .. concours ..
    + numeroConcours : String
    + nomConcours : String {copie}
    .. siège (0..1) ..
    + idCentre : Long
    + idEtablissement : Long
    + idSalle : Long
    + numeroPlace : Integer
    --
    + importer()
    + consulter()
    + modifier()
    + supprimer()
    + reinitialiserListe()
    + affecterManuellement()
  }
}

package "Répartition" as pkgRepart #FAF4FF {
  class RepartitionRun {
      - id : Long <<PK>>
      + declenchePar : String
      + statut : RepartitionStatut
      + totalCandidats : int
      + totalAffectes : int
      + totalAlertes : int
      + demarreLe : Instant
      + termineLe : Instant
      + message : String
      --
      + lancer()
      + consulter()
      + reinitialiserAffectations()
      + supprimer()
    }
    enum RepartitionStatut <<enumeration>> {
      TERMINEE
      TERMINEE_AVEC_ALERTES
      ECHEC
    }
  class RepartitionAffectation {
    - id : Long <<PK>>
    .. candidat ..
    + numeroInscription : String
    + candidatNom : String {copie}
    + ville : String {copie}
    .. concours ..
    + numeroConcours : String
    + nomConcours : String {copie}
    .. lieu ..
    + centreId : Long
    + nomCentre : String {copie}
    + etablissementId : Long
    + nomEtablissement : String {copie}
    + salleId : Long
    + nomSalle : String {copie}
    + numeroPlace : Integer
  }
  class RepartitionAlerte {
    - id : Long <<PK>>
    + type : AlerteType
    + message : String
    .. candidat (0..1) ..
    + numeroInscription : String
    + candidatNom : String {copie}
    + ville : String {copie}
    .. concours / centre ..
    + numeroConcours : String
    + nomConcours : String {copie}
    + centreId : Long
    + nomCentre : String {copie}
  }
  enum AlerteType <<enumeration>> {
    CAPACITE_DEPASSEE
    AUCUN_CENTRE_DISPONIBLE
    CONCOURS_INCONNU
    VILLE_NON_GEOLOCALISEE
  }
  RepartitionAlerte --> AlerteType
  RepartitionRun --> RepartitionStatut
  RepartitionRun "1" *-- "0..*" RepartitionAffectation
  RepartitionRun "1" *-- "0..*" RepartitionAlerte
  RepartitionStatut -[hidden]right- RepartitionAffectation
}

package "Convocations" as pkgConvoc #FFF4F4 {
  class Convocation <<assemblé>> {
    + numeroInscription : String
    + nom : String
    + prenom : String
    + email : String
    + numeroConcours : String
    + nomConcours : String
    + nomCentre : String
    + nomEtablissement : String
    + nomSalle : String
    + dateHeureExamen : Instant
    + numeroPlace : Integer
    --
    + consulter()
    + telechargerPdf()
    + envoyerToutes()
  }
  class ConvocationEnvoi {
    - id : Long <<PK>>
    + numeroInscription : String
    + candidatNom : String {copie}
    + email : String {copie}
    + numeroConcours : String
    + nomConcours : String {copie}
    + statut : EnvoiStatut
    + message : String
    + declenchePar : String
    + envoyeLe : Instant
    --
    + consulter()
    + reinitialiser()
  }
  enum EnvoiStatut <<enumeration>> {
    ENVOYE
    ECHEC
  }
  ConvocationEnvoi --> EnvoiStatut
}

' Références inter-services (identifiants, pas de FK SQL)
ConcoursAffectationCentre "0..*" ..> "1" Centre
Salle "0..*" ..> "0..1" Concours
Candidat "0..*" ..> "0..1" Concours
Candidat "0..*" ..> "0..1" Salle
RepartitionAffectation "0..*" ..> "1" Candidat
RepartitionAlerte "0..*" ..> "0..1" Candidat
Candidat "1" ..> "0..1" Convocation
ConvocationEnvoi "0..*" ..> "1" Candidat

@enduml
