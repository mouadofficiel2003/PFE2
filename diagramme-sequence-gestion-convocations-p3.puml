@startuml diagramme-sequence-gestion-convocations-p3
!theme plain
skinparam shadowing false
skinparam roundcorner 10
skinparam dpi 180
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false

<style>
title {
  FontSize 32
  FontStyle bold
  Margin 8
}
document {
  FontSize 26
}
sequenceDiagram {
  actor {
    FontSize 28
    FontStyle bold
    Padding 8
  }
  participant {
    FontSize 26
    FontStyle bold
    Padding 8
  }
  database {
    FontSize 26
    FontStyle bold
    Padding 8
  }
  arrow {
    FontSize 26
    LineThickness 2
  }
  divider {
    FontSize 24
    FontStyle bold
  }
  group {
    FontSize 22
  }
  lifeLine {
    LineThickness 2
  }
}
</style>

title Gestion des convocations (3/3) — Envoyer toutes les convocations

actor "Gestionnaire" as Gest
participant "Application\nweb (React)" as React
participant "Passerelle" as GW
participant "Convocations" as Conv
participant "Gmail\n(SMTP)" as Mail
database "PostgreSQL" as DB

== Envoyer toutes les convocations ==

Gest -> React : Clique « Envoyer toutes les convocations »
React -> GW : POST /api/convocations/envoyer
GW -> Conv : Transmet
alt E-mail non configuré
  Conv --> GW : 503 Service Unavailable
  GW --> React : 503 Service Unavailable
  React --> Gest : Message d'erreur
else Aucun candidat affecté
  Conv --> GW : 400 Bad Request
  GW --> React : 400 Bad Request
  React --> Gest : Message d'erreur
else Envoi
  Conv -> Conv : Réassemble les convocations prêtes
  loop Pour chaque convocation
    Conv -> Conv : Générer le PDF
    Conv -> Mail : E-mail + PDF en pièce jointe
    Mail --> Conv : Succès ou échec
  end
  Conv -> DB : INSERT convocation_envoi (ENVOYE / ECHEC)
  DB --> Conv : OK
  Conv --> GW : 200 OK { bilan }
  GW --> React : 200 OK
  React --> Gest : Affiche le bilan d'envoi
end

@enduml
