@startuml diagramme-sequence-repartition-automatique
!theme plain
skinparam shadowing false
skinparam roundcorner 8
skinparam dpi 96
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

<style>
title {
  FontSize 26
  FontStyle bold
}
document {
  FontSize 22
}
sequenceDiagram {
  actor {
    FontSize 22
  }
  participant {
    FontSize 20
  }
  database {
    FontSize 20
  }
  arrow {
    FontSize 20
    LineThickness 1.5
  }
  divider {
    FontSize 20
  }
  group {
    FontSize 18
  }
  note {
    FontSize 18
  }
  lifeLine {
    LineThickness 1.5
  }
}
</style>

title Dématérialisation des candidatures — Séquence : répartition automatique

actor "Gestionnaire" as Gest
participant "Application\nWeb (React)" as React
participant "Passerelle\nAPI" as GW
participant "Répartition" as Rep
participant "Concours" as Conc
participant "Lieux" as Lieux
participant "Candidats" as Cand
database "PostgreSQL" as DB

== Déclenchement ==
Gest -> React : Clique sur « Lancer la répartition »
React -> GW : POST /api/repartition/run
GW -> Rep : Transmet POST /api/repartition/run

== Lecture des référentiels ==
Rep -> Conc : GET /api/concours
Conc --> Rep : 200 OK { liste des concours }

loop Pour chaque concours
  Rep -> Lieux : GET /api/salles?numeroConcours=
  Lieux --> Rep : 200 OK { salles, centres,\ncapacités }
end

Rep -> Cand : GET /api/candidats
Cand --> Rep : 200 OK { candidats\n(ville, concours) }

== Calcul du plan (en mémoire) ==
loop Pour chaque candidat\n(trié par numéro d'inscription)
  Rep -> Rep : Classer les centres du concours\npar proximité\n(même ville, même région, distance)
  alt Une salle a encore de la place
    Rep -> Rep : Réserver une place\n(centre, établissement, salle, place)
  else Impossible d'affecter
    Rep -> Rep : Alerte (capacité, aucun centre,\nconcours inconnu, ville inconnue)
  end
end

== Écriture des affectations et de l'historique ==
Rep -> Cand : PATCH /api/candidats/affectations
Cand --> Rep : 200 OK
Rep -> DB : INSERT run, affectations, alertes
DB --> Rep : OK
Rep --> GW : 201 Created { synthèse }
GW --> React : 201 Created
React --> Gest : Affiche le résultat\n(affectés, alertes)

note over React, Rep
  La requête du navigateur passe par la passerelle
  avec Authorization: Bearer <jeton>.
  Le service répartition relaie ce jeton
  vers concours, lieux et candidats
  (appels de service à service).
  Redistribution complète : les candidats non placés
  voient leur affectation remise à zéro.
end note

@enduml
